conformance/client/adapters/CLI_ADAPTER.md
infra/railway-deploy.md
docs/SCOPE.md
docs/VOCABULARY.md

# Coverage artifacts (R1)
.coverage
coverage.json

# durable member-persist outbox (local runtime artifact, never committed)
member_persist_outbox.jsonl
server/member_persist_outbox.jsonl

# Never commit built wheels to this repo (guarded by test_no_committed_wheels.py).
*.whl

# Deepwork state files (workflow-only, never committed)
.slim/deepwork/

# Internal working docs — never commit (see internal-vs-external-voice).
*.tmp.md

# scripts/demo_two_agents.sh — its evidence directory and the venv it builds when no runtime is installed
demo-evidence/
.orrery-demo-venv/
