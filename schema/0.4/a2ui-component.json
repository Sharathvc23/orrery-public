    {
      "if": {
        "properties": {
          "component": {
            "const": "List"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/List"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Avatar"
          }
        }
      },
