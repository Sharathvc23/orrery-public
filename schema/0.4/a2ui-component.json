      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "ChipGroup"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/ChipGroup"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Toast"
          }
        }
      },
      "then": {
