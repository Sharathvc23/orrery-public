    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Input"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Input"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "TextArea"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/TextArea"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Select"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Select"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Toggle"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Toggle"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "ActionButton"
          }
