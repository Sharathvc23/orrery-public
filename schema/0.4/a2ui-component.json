      }
    }
  ],
  "$defs": {
    "idRef": {
      "type": "string",
      "minLength": 1
    },
    "Meta": {
      "description": "Optional v0.10 metadata block. Four reserved namespaces (a11y, responsive, density, render) own their fields via downstream PRs C2-C5; until those land, namespace bodies MUST be empty. Vendor extensions are allowed under keys matching ^x-[a-z][a-z0-9-]*$.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^x-[a-z][a-z0-9-]*$": {
          "type": "object"
        }
      },
      "properties": {
        "a11y": {
          "$ref": "#/$defs/MetaA11y"
        },
        "responsive": {
          "$ref": "#/$defs/MetaResponsive"
        },
        "density": {
          "$ref": "#/$defs/MetaDensity"
        },
        "render": {
          "$ref": "#/$defs/MetaRender"
        }
      }
    },
    "MetaA11y": {
      "type": "object",
      "additionalProperties": false,
      "description": "ARIA descriptors for screen readers and assistive tech. Owned by PR-C2. Renderers MUST use these to override default DOM-derived a11y attributes when present.",
      "properties": {
        "ariaLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Replaces the visible label for assistive tech. Use when the visible label (e.g. an icon button) would not read meaningfully aloud."
        },
        "ariaDescribedBy": {
          "type": "string",
          "minLength": 1,
          "description": "id reference to another component in the same surface whose text content describes this component. Mirrors HTML aria-describedby."
        },
        "role": {
          "type": "string",
          "enum": [
            "button",
            "link",
            "checkbox",
            "radio",
            "switch",
            "menuitem",
            "tab",
            "tabpanel",
            "dialog",
            "alertdialog",
            "alert",
            "status",
            "progressbar",
            "navigation",
            "search",
            "form",
            "region"
          ],
          "description": "ARIA role override. Restricted to a closed set to prevent invalid roles. Renderers SHOULD trust this over their default mapping."
        },
        "ariaLive": {
          "enum": [
            "off",
            "polite",
            "assertive"
          ],
          "description": "aria-live region politeness. Use 'polite' for status updates the user should hear when idle; 'assertive' interrupts the screen reader."
        },
        "ariaHidden": {
          "type": "boolean",
          "description": "Hides the component from assistive tech (renders visually). Use sparingly \u2014 only for purely decorative content."
        }
      }
    },
    "MetaResponsive": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-component responsive layout hints. Owned by PR-C3. Renderers SHOULD use these to drive viewport-conditional layout decisions; absence MUST behave identically to v0.9.",
      "properties": {
        "minWidthCh": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "Minimum width in character-units (`ch`) below which the renderer SHOULD collapse, wrap, or truncate the component. Useful for narrow components like trust badges that lose meaning when too small."
        },
        "breakpointHide": {
          "enum": [
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "Hide the component at viewport widths *below* this breakpoint. Tailwind-aligned: sm=640px, md=768px, lg=1024px, xl=1280px. Use to drop secondary content on mobile."
        },
        "stackBelow": {
          "enum": [
            "sm",
            "md",
            "lg",
            "xl"
          ],
          "description": "For container components (Row/Grid/Form): switch to vertical stacking at viewport widths below this breakpoint. Renderers ignore this on non-container components."
        },
        "fullBleed": {
          "type": "boolean",
          "description": "When true, the component MAY break out of the parent container's max-width to span the viewport (e.g. a hero image). Renderers MAY clamp to viewport width regardless of layout hierarchy."
        },
        "order": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Optional reorder hint within a flex/grid container. Lower values render first. Renderers MAY ignore on non-flex layouts."
        }
      }
    },
    "MetaDensity": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-component density override. Owned by PR-C4. Renderers SHOULD apply this when present; absence falls back to surface-level density (see a2ui-surface.json createSurface.meta.density) and then to renderer default ('comfortable').",
      "properties": {
        "preferred": {
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ],
          "description": "Component-level density preference. Overrides surface-level density for this one component."
        }
      }
    },
    "MetaRender": {
      "type": "object",
      "additionalProperties": false,
      "description": "Cross-cutting render hints; fields land alongside the namespace that introduces each. Empty in PR-C1."
    },
    "childrenArray": {
      "description": "Either a bare array of id-refs (v0.9) or {explicitList:[...]} (v0.8 back-compat).",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/idRef"
          }
        },
        {
          "type": "object",
          "required": [
            "explicitList"
          ],
          "additionalProperties": false,
          "properties": {
            "explicitList": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/idRef"
              }
            }
          }
        }
      ]
    },
    "Text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Text"
        },
        "text": {
          "type": "string"
        },
        "usageHint": {
          "enum": [
            "h1",
            "h2",
            "h3",
            "h4",
            "body",
            "caption"
          ]
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "text",
        "level"
      ],
      "properties": {
