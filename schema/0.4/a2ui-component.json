        },
        "component": {
          "const": "Heading"
        },
        "text": {
          "type": "string"
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Markdown": {
      "type": "object",
