      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Tabs"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Tabs"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Table"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Table"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Accordion"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Accordion"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Callout"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Callout"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "TrustBadge"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/TrustBadge"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Timeline"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Timeline"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "MemberCard"
          }
        }
      },
