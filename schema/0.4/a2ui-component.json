        },
        "language": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "child"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Card"
        },
        "child": {
          "$ref": "#/$defs/idRef"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Column"
        },
        "children": {
          "$ref": "#/$defs/childrenArray"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Row"
        },
        "children": {
          "$ref": "#/$defs/childrenArray"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Grid"
        },
        "children": {
          "$ref": "#/$defs/childrenArray"
        },
        "cols": {
          "type": "integer",
          "minimum": 1
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Divider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Divider"
        },
        "axis": {
          "enum": [
            "horizontal",
            "vertical"
          ]
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Badge"
        },
        "text": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "default",
            "secondary",
            "destructive",
            "outline"
          ]
        },
        "color": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Progress"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "label": {
          "type": "string"
        },
        "color": {
          "enum": [
            "default",
            "green",
            "yellow",
            "red"
          ]
        },
        "meta": {
          "$ref": "#/$defs/Meta"
        }
      }
    },
    "Metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "value",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Metric"
        },
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "trend": {
          "enum": [
