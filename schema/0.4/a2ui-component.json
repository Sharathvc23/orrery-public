{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanda.org/schema/0.4/a2ui-component.json",
  "title": "A2UI v0.10 Component",
  "description": "A single component in an A2UI v0.10 surface. The discriminator is the `component` field; per-type sub-schemas in `$defs` constrain the remaining properties. v0.10 adds an optional `meta` block (see spec/0.4/a2ui.md \u00a710) \u2014 every per-type sub-schema accepts `meta` via the shared `$defs/Meta` reference. See spec/0.4/a2ui.md \u00a73.",
  "type": "object",
  "required": [
    "id",
    "component"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "component": {
      "type": "string",
      "enum": [
        "Text",
        "Heading",
        "Markdown",
        "CodeBlock",
        "Card",
        "Column",
        "Row",
        "Grid",
        "Divider",
        "Badge",
        "Progress",
        "Metric",
        "Stat",
        "List",
        "Avatar",
        "Image",
        "Alert",
        "Link",
        "Tabs",
        "Table",
        "Accordion",
        "Callout",
        "TrustBadge",
        "Timeline",
        "MemberCard",
        "StatGroup",
        "Input",
        "TextArea",
        "Select",
        "Toggle",
        "ActionButton",
        "Form",
        "Chip",
        "ChipGroup",
        "Toast"
      ]
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "component": {
            "const": "Text"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Text"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Heading"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Heading"
      }
    },
