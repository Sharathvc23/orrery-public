    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Grid"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Grid"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Divider"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/Divider"
      }
    },
    {
      "if": {
        "properties": {
          "component": {
            "const": "Badge"
          }
        }
      },
