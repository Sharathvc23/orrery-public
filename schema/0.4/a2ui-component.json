        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Avatar"
        },
        "name": {
          "type": "string"
        },
        "imageUrl": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "meta": {
          "$ref": "#/$defs/Meta"
