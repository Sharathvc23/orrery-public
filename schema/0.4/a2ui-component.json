    "Stat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "component",
        "label",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "component": {
          "const": "Stat"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
