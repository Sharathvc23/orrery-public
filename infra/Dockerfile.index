# Lean Index image — the NEST-compatible corroboration registry for the
# cross-registry divergence detector. Build context is the REPO ROOT
# (parity with Dockerfile.server): docker build -f infra/Dockerfile.index .
FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

RUN apt-get update \
  && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# M14: install from a fully-resolved, hash-pinned lock rather than inline ranges.
# --require-hashes makes pip refuse any artifact the lock did not name, so a
# build of this commit installs the same tree today and in six months.
COPY index/requirements.lock /app/index-requirements.lock

# pip 26.2.2, pinned by artifact hash. Every pip BEFORE 26.2.2 keeps trusting the
# eMudhra/emSign intermediates whose private keys turned out to be recoverable
# (Oct 2026), regardless of the system trust store.
#
# This image is the least exposed of the four, because `--require-hashes` below
# already verifies every artifact by digest, so a swapped download fails the hash
# check whatever the TLS chain said. Upgraded anyway: that exemption holds only
# while every install here stays hash-pinned, which is a property of the next edit
# to this file rather than of this one.
#
# The `#sha256=` fragment makes the bootstrap safe: this download is performed by
# the OLD pip, so the artifact is verified by HASH rather than by the TLS chain.
RUN pip install --no-cache-dir "pip @ https://files.pythonhosted.org/packages/3f/06/3e4420302363fbb71be3c7f35ce042f54bfca330e3e66b3a2e3c4cca579f/pip-26.2.2-py3-none-any.whl#sha256=fd7f4dfa8190e014013b9f08f3e973f4e4c26ffd179a204895533a7254813a70"

RUN pip install --no-cache-dir --require-hashes -r /app/index-requirements.lock

COPY index/ /app/index/

WORKDIR /app/index
ENV PORT=7100 \
    INDEX_DB_PATH=/data/index.db

EXPOSE 7100
HEALTHCHECK --interval=15s --timeout=5s --retries=20 \
  CMD curl -fsS "http://localhost:${PORT:-7100}/health" || exit 1

# Non-root: the index process runs as uid 10001.
#
# /app is image content, so owning it at build time is correct and final.
#
# /data IS NOT. At build time it is an empty directory in the image; at runtime
# the platform mounts a volume over it carrying the ownership of whatever wrote
# it — root — so uid 10001 could not write and sqlite failed every write with
# "attempt to write a readonly database" while reads kept answering. A
# build-time chown cannot fix a runtime mount; the adoption has to happen after
# the mount and before privileges drop, which is what the entrypoint does.
#
# There is no USER instruction, for the same reason Dockerfile.agent has none:
# dropping here would leave the entrypoint unable to adopt the volume. It starts
# as root, adopts the directory holding INDEX_DB_PATH, and execs the index as
# orrery via setpriv, so no privileged process survives it.
RUN groupadd --gid 10001 orrery \
  && useradd --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin orrery \
  && mkdir -p /data /home/orrery \
  && chown -R orrery:orrery /app /home/orrery

COPY infra/index-entrypoint.sh /usr/local/bin/index-entrypoint.sh
RUN chmod 0755 /usr/local/bin/index-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/index-entrypoint.sh"]
CMD ["python", "main.py"]
