# Orrery manual-setup template — copy to .env before running `docker compose up`.
# Generate fresh, independent values for POSTGRES_PASSWORD and ORRERY_KEY_SECRET
# for every install before startup. Optional LLM provider keys only enable
# generative features; they do not replace these required install-local secrets.

# ── Stock Compose allowlist ──────────────────────────────────────────────────
# Stock Compose does not bulk-forward this file. Alongside pre-existing mapped
# deployment settings, its newly supported server-setting allowlist is exactly:
# ORRERY_PROFILE, LLM_PROVIDER, LLM_MODEL, LLM_BASE_URL,
# ORG_RETENTION_SWEEP_ENABLED, ORG_RETENTION_SWEEP_DRY_RUN, ORG_ADMIN_TOKEN,
# KLAVIYO_LIVE_SENDS, and KLAVIYO_API_KEY.
#
# Proxy controls, Index v2/account fields, CHAPTER_* aliases, DEFAULT_LLM_MODEL,
# and container-owned path inputs are bare-server runtime controls, not stock
# Compose inputs, pending separate follow-ups. Putting them in this .env does not
# configure the stock Compose server.

# ── Your org ──────────────────────────────────────────────────────────────────
ORG_ID=demo-org
ORG_NAME=Demo Org
ORG_DESCRIPTION=A self-hosted Orrery org of accountable agents.

# ── Server ────────────────────────────────────────────────────────────────────
# PUBLIC_URL is the origin inside the org's did:web and every endpoint it
# serves; SERVER_PORT is the host port Compose publishes. Under ./orrery-up a
# loopback PUBLIC_URL follows SERVER_PORT; a real hostname is never rewritten.
PUBLIC_URL=http://localhost:7000
SERVER_PORT=7000
# Compose publishes the org and optional local agent on loopback by default.
# Set either host deliberately only when another machine or proxy must reach it.
SERVER_BIND_HOST=127.0.0.1
AGENT_BIND_HOST=127.0.0.1
# Deployment profile. prod is the DEFAULT and narrows CORS to an explicit
# ALLOWED_ORIGINS allowlist (empty = no foreign-origin browser access) while
# turning OFF /docs + /redoc + /openapi.json. It is one hardening layer, not a
# complete public-deployment checklist. See docs/CONFIGURATION.md § Production profile.
ORRERY_PROFILE=prod
# Stock Compose also falls back to prod when this is absent or empty. Set
# ORRERY_PROFILE=dev explicitly for prior local wildcard-CORS and API-doc behavior;
# ./orrery-up continues to write dev explicitly.
# Cross-origin browser allowlist (comma-separated origins) for prod. Leave blank to
# disallow all foreign-origin browser reads; signed server-to-server calls are unaffected.
ALLOWED_ORIGINS=
# Bearer token gating /metrics for external Prometheus scrapers. Blank = the
# endpoint is open (fine for local/dev). Set a long random value in prod.
METRICS_BEARER_TOKEN=
# ── Bare-server-only: trusted proxy / real client IP ─────────────────────────
# Stock Compose does not forward these proxy controls. They are retained here as
# bare-server runtime reference; setting them in this .env has no effect on the
# stock Compose server.
# When the org runs behind an edge/reverse proxy (Railway, nginx, a load
# balancer), set TRUSTED_PROXY_HOPS to the number of trusted proxies between the
# client and this server (a single edge proxy = 1). The per-IP rate limiter then
# keys on the real client IP from X-Forwarded-For instead of the proxy's IP, so one
# abuser can't rate-limit everyone. 0 (default) = direct connect, X-Forwarded-For
# is NOT trusted. FORWARDED_ALLOW_IPS is the peer(s) uvicorn accepts forwarded
# headers from (the edge proxy's address, or `*` if the network already isolates it).
# NOTE: the limiter is in-memory PER PROCESS — fine single-worker; a multi-worker /
# multi-replica deploy needs a shared store (Redis) for a global ceiling.
TRUSTED_PROXY_HOPS=0
FORWARDED_ALLOW_IPS=127.0.0.1
# Rate-limiter buckets are snapshotted to Postgres and restored on boot, keyed
# by HMAC(salt, client IP) so the table never holds an address. The snapshot is
# only usable if the NEXT process hashes with the SAME salt. Unset, the salt is
# a file under server/.org — durable on stock Compose, which mounts that
# directory on a volume, and minted fresh on every boot of a service with no
# persistent filesystem (a container platform with no volume attached). On such
# a service set this; at least 16 characters, keep it OUTSIDE the database.
# `GET /health` reports `rate_limit_salt.source` (env / file / file-new /
# ephemeral / env-rejected) and `rate_limit_salt.durable`; `file-new` on every
# boot is the symptom this exists to fix.
#   generate:  openssl rand -hex 32
ORRERY_RATE_LIMIT_SALT=

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_DB=orrery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=orrery-dev-password-change-me

# Password for the non-superuser application role the server connects as.
# Required. The superuser above applies migrations and initialises the database;
# it is not what serves requests. Generate an independent value:
#   openssl rand -hex 32
APP_DB_PASSWORD=

# ── Optional: bring your own LLM key to enable generative features ────────────
OPENAI_API_KEY=
LLM_API_KEY=
# Registry publication. EMPTY = publish nowhere, which is the default and the
# only safe value to ship: this file is copied verbatim into real installs, so
# a live URL here is a live URL in production. Set it only when you intend this
# org to appear in a public registry (the NEST URL is in docs/CONFIGURATION.md).
REGISTRY_URL=
AUTO_REGISTER=false

# ── Federation security (enforced by default) ──────────────────────────────
# Broadcasts must carry a valid signature; discovery only uses signed,
# DID-pinned records. Set to false ONLY for a deliberate warn-only migration
# window — with these off, a peer can forge cross-org broadcasts and a cheating
# registry can serve tampered endpoints that are used unverified.
FEDERATION_ENFORCE_SIGNED_BROADCASTS=true
FEDERATION_REQUIRE_SIGNED_RECORDS=true

# ── Secret encryption at rest (REQUIRED) ───────────────────────────────────
# Seals, with AES-256-GCM, every secret the org stores in the database or on
# disk: the org's Ed25519 signing key (chapter_keys) and members' LLM provider
# keys (agent_api_keys). Without it a database dump or backup is full
# identity-forgery material — an attacker can sign ARP receipts, VRP
# attestations and federation broadcasts as this org.
#
# THE SERVER WILL NOT START if this is unset or empty. It used to boot anyway
# and store the signing key in plaintext after printing one warning line
# (AUDIT_HARSH C11/C1); absent configuration selected the least safe branch and
# then went quiet. Set it before deploying.
#
# Store it OUTSIDE the database, in a secrets manager or separate env. It is
# also what makes a database dump restorable — see docs/BACKUP_RESTORE.md.
#   generate:  openssl rand -hex 32
ORRERY_KEY_SECRET=
# Rotating ORRERY_KEY_SECRET: put the OLD value here, the new one above, restart
# once (the boot log reseals the signing key and provider keys in place), then
# clear this and restart again. Nothing is ever sealed under this value.
ORRERY_KEY_SECRET_PREVIOUS=

# Set to false ONLY to deliberately accept plaintext secrets at rest — a local
# test box, or a deployment where the database shares the server process's trust
# boundary. Then ORRERY_KEY_SECRET may be left empty and the server boots,
# logging each unsealed write. Anything other than a recognised false spelling
# (false/0/no/off) still requires sealing, so a typo cannot disable it.
ORRERY_REQUIRE_SEALED_SECRETS=true

# ── Scheduled database backups (optional sidecar) ────────────────────────
# The `db-backup` service (compose profile "backup") dumps the org database on an
# interval. Off unless you start it:  docker compose --profile backup up -d
# Reminder: the dump holds the SEALED signing key — back up ORRERY_KEY_SECRET
# separately or the dump can't be restored to a working identity. See
# docs/BACKUP_RESTORE.md.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# ── Bare-server-only: NANDA Index v2 (the leveled 4-hop discovery layer) ─────
# Stock Compose does not forward these Index v2/account fields. They are
# bare-server runtime controls pending a separate Compose follow-up; setting
# them in this .env does not enable registration in the stock stack.
# Orrery registers as an ORG with hosting_path=registry (it serves its own card,
# so it is its own registry). Registration is OPERATOR-TRIGGERED — POST
# /admin/api/index-v2/register (admin-auth) — and never auto-fires on startup, so
# there are no surprise network calls. Leave INDEX_ACCOUNT_* blank to disable.
# Point NANDA_INDEX_URL at http://localhost:3001 for the local testbed;
# https://api.nandaindex.org is the live index (operator-gated).
NANDA_INDEX_URL=
INDEX_ACCOUNT_EMAIL=
INDEX_ACCOUNT_PASSWORD=
ORG_DOMAIN=
ORG_CONTACT_EMAIL=
# org_id at the index (^[a-z0-9][a-z0-9-]*[a-z0-9]$); defaults to a sanitized
# lowercase ORG_ID when blank.
INDEX_ORG_ID=

# ── Optional: data retention sweep ─────────────────────────────────────────
# The org ages out retention-bounded rows on a schedule. It ENFORCES by default
# (real deletion of rows past their per-category TTL) — a stock deploy must not
# advertise data-minimization while deleting nothing. Want a review period
# first? Set DRY_RUN=true to audit "would-delete" counts without deleting, then
# flip it back to false. The bare server accepts CHAPTER_* aliases, but stock
# Compose forwards only these canonical ORG_* names.
ORG_RETENTION_SWEEP_ENABLED=true
ORG_RETENTION_SWEEP_DRY_RUN=false

# ── Optional: admin surface ────────────────────────────────────────────────
# Bearer token gating the admin endpoints. Blank means the server loads the
# persisted token or generates a fresh one on first startup, stores it mode 0600
# in the org data volume, and prints it exactly once. Set a value here when your
# secret manager should control the credential. The bare server accepts the
# CHAPTER_ADMIN_TOKEN alias, but stock Compose forwards only ORG_ADMIN_TOKEN.
ORG_ADMIN_TOKEN=

# ── Optional: LLM provider selection (with a key from BYOK above) ───────────
# Unset LLM_PROVIDER auto-detects from whichever provider key is set (prefers
# anthropic). Override the model / base URL only if you need to.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# ── Outbound email (Klaviyo) — OFF, and deliberately so ─────────────────────
#
# 🛑 A LIVE SEND EMAILS A REAL PERSON. The live transport requires both a
# recognized-true flag and a nonempty API key. Without either, an authorized
# send stays in the restricted sandbox, where the only permitted recipients are
# RFC 2606 reserved addresses (example.com, *.test, *.invalid) that cannot
# belong to anyone.
#
# KLAVIYO_LIVE_SENDS is read through env_flags.security_flag(default=False), so
# unset, empty AND misspelled all mean sandbox — `ture` is a typo, not a
# decision to start mailing people. Leave it unset unless you mean it.
#
# Every send additionally requires operator authorization: either an exact,
# single-use `send_external` approval matched to that recipient, subject, and
# body, or an applicable bounded `send_external` grant. Without authorization,
# the send is refused or queued and does not deliver; it is not sandbox delivery.
# The flags below decide only which transport an authorized send uses.
KLAVIYO_LIVE_SENDS=false
# KLAVIYO_API_KEY=
